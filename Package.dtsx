    public override void CreateNewOutputRows()
    {
        // Force TLS 1.2 for HTTPS requests
        System.Net.ServicePointManager.SecurityProtocol = System.Net.SecurityProtocolType.Tls12;

        string apiKey = Variables.SportsDataApiKey;

        string url = "https://api.sportsdata.io/api/nhl/fantasy/json/Players?key=" + apiKey;

        try
        {
            using (var client = new HttpClient())
            {
                // Send GET request
                var response = client.GetStringAsync(url).Result;

                // Deserialize JSON
                var players = JsonConvert.DeserializeObject<List<Player>>(response);

                foreach (var p in players)
                {
                    Output0Buffer.AddRow();

                    Output0Buffer.PlayerID = p.PlayerID;
                    Output0Buffer.FirstName = (p.FirstName ?? "").Substring(0, Math.Min(50, (p.FirstName ?? "").Length));
                    Output0Buffer.LastName = (p.LastName ?? "").Substring(0, Math.Min(50, (p.LastName ?? "").Length));
                    Output0Buffer.Status = (p.Status ?? "").Substring(0, Math.Min(50, (p.Status ?? "").Length));
                    Output0Buffer.TeamID = p.TeamID;
                    Output0Buffer.Team = (p.Team ?? "").Substring(0, Math.Min(50, (p.Team ?? "").Length));
                    Output0Buffer.Position = (p.Position ?? "").Substring(0, Math.Min(50, (p.Position ?? "").Length));

                    // Nullable Jersey
                    if (p.Jersey.HasValue)
                        Output0Buffer.Jersey = p.Jersey.Value;
                    else
                        Output0Buffer.Jersey_IsNull = true;

                    // Nullable Catches/Shoots
                    Output0Buffer.Catches = (p.Catches ?? "").Substring(0, Math.Min(5, (p.Catches ?? "").Length));
                    if (!string.IsNullOrEmpty(p.Shoots))
                        Output0Buffer.Shoots = p.Shoots.Substring(0, Math.Min(5, p.Shoots.Length));
                    else
                        Output0Buffer.Shoots_IsNull = true;

                    //Output0Buffer.Height = p.Height;
                    if (p.Height.HasValue)
                    {
                        Output0Buffer.Height = p.Height.Value;
                    }
                    else
                    {
                        Output0Buffer.Height_IsNull = true;
                    }

                    //Output0Buffer.Weight = p.Weight;
                    if (p.Weight.HasValue)
                    {
                        Output0Buffer.Weight = p.Weight.Value;
                    }
                    else
                    {
                        Output0Buffer.Weight_IsNull = true;
                    }



                    //Output0Buffer.BirthDate = p.BirthDate;
                    if (p.BirthDate.HasValue)
                    {
                        Output0Buffer.BirthDate = p.BirthDate.Value;
                    }
                    else
                    {
                        Output0Buffer.BirthDate_IsNull = true;
                    }

                    Output0Buffer.BirthCity = (p.BirthCity ?? "").Substring(0, Math.Min(50, (p.BirthCity ?? "").Length));
                    Output0Buffer.BirthState = (p.BirthState ?? "").Substring(0, Math.Min(50, (p.BirthState ?? "").Length));
                    Output0Buffer.PhotoUrl = (p.PhotoUrl ?? "").Substring(0, Math.Min(200, (p.PhotoUrl ?? "").Length));
                    Output0Buffer.InjuryStatus = (p.InjuryStatus ?? "").Substring(0, Math.Min(50, (p.InjuryStatus ?? "").Length));

                    // Nullable IDs
                    Output0Buffer.FanDuelPlayerID = p.FanDuelPlayerID.HasValue ? p.FanDuelPlayerID.Value : 0;
                    Output0Buffer.DraftKingsPlayerID = p.DraftKingsPlayerID.HasValue ? p.DraftKingsPlayerID.Value : 0;

                    Output0Buffer.FanDuelName = (p.FanDuelName ?? "").Substring(0, Math.Min(50, (p.FanDuelName ?? "").Length));
                    Output0Buffer.DraftKingsName = (p.DraftKingsName ?? "").Substring(0, Math.Min(50, (p.DraftKingsName ?? "").Length));
                }
            }
        }
        catch (Exception ex)
        {
            // Log the error to SSIS
            bool cancel;
            this.ComponentMetaData.FireError(0, "Script Component",
                $"Error fetching or parsing API: {ex.Message}", "", 0, out cancel);
        }
    }

    // Player class for JSON mapping
    public class Player
    {
        public int PlayerID { get; set; }
        public string FirstName { get; set; }
        public string LastName { get; set; }
        public string Status { get; set; }
        public int TeamID { get; set; }
        public string Team { get; set; }
        public string Position { get; set; }
        public int? Jersey { get; set; }
        public string Catches { get; set; }
        public string Shoots { get; set; }
        public int? Height { get; set; }
        public int? Weight { get; set; }
        public DateTime? BirthDate { get; set; }
        public string BirthCity { get; set; }
        public string BirthState { get; set; }
        public string PhotoUrl { get; set; }
        public string InjuryStatus { get; set; }
        public int? FanDuelPlayerID { get; set; }
        public int? DraftKingsPlayerID { get; set; }
        public string FanDuelName { get; set; }
        public string DraftKingsName { get; set; }
    }




}
]]></arrayElement>
