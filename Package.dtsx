                    <arrayElement
                      dataType="System.String"><![CDATA[#region Namespaces
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;
using System;
using System.Collections.Generic;
using System.Net.Http;
using Newtonsoft.Json;
#endregion

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    System.Net.Http.HttpClient client = new System.Net.Http.HttpClient();

    public override void PreExecute()
    {
        base.PreExecute();
    }

    public override void PostExecute()
    {
        base.PostExecute();
    }

    public override void CreateNewOutputRows()
    {
        System.Net.ServicePointManager.SecurityProtocol = System.Net.SecurityProtocolType.Tls12;

        string apiKey = Variables.SportsDataApiKey;

        string url = "https://api.sportsdata.io/api/nhl/fantasy/json/Teams?key=" + apiKey;

        try
        {
            using (var client = new HttpClient())
            {
                var response = client.GetStringAsync(url).Result;
                var teams = JsonConvert.DeserializeObject<List<Team>>(response);

                // Keep track of TeamIDs already added to avoid duplicates
                HashSet<long> addedTeamIDs = new HashSet<long>();

                foreach (var t in teams)
                {
                    // Skip duplicate TeamIDs
                    if (addedTeamIDs.Contains(t.TeamID))
                        continue;

                    Output0Buffer.AddRow();

                    Output0Buffer.TeamID = t.TeamID;
                    Output0Buffer.Key = t.Key ?? "";
                    Output0Buffer.Active = t.Active;
                    Output0Buffer.City = t.City ?? "";
                    Output0Buffer.Name = t.Name ?? "";
                    Output0Buffer.StadiumID = t.StadiumID.HasValue ? t.StadiumID.Value : 0;
                    Output0Buffer.Conference = t.Conference ?? "";
                    Output0Buffer.Division = t.Division ?? "";
                    Output0Buffer.PrimaryColor = t.PrimaryColor ?? "";
                    Output0Buffer.SecondaryColor = t.SecondaryColor ?? "";
                    Output0Buffer.TertiaryColor = t.TertiaryColor ?? "";
                    Output0Buffer.QuaternaryColor = t.QuaternaryColor ?? "";
                    Output0Buffer.WikipediaLogoUrl = t.WikipediaLogoUrl ?? "";
                    Output0Buffer.WikipediaWordMarkUrl = t.WikipediaWordMarkUrl ?? "";
                    Output0Buffer.GlobalTeamID = t.GlobalTeamID.HasValue ? t.GlobalTeamID.Value : 0;

                    // Mark this TeamID as added
                    addedTeamIDs.Add(t.TeamID);
                }
            }
        }
        catch (Exception ex)
        {
            bool cancel;
            this.ComponentMetaData.FireError(0, "Script Component",
                $"Error fetching or parsing API: {ex.Message}", "", 0, out cancel);
        }
    }


    // Map JSON to C# class
    public class Team
    {
        public long TeamID { get; set; }           // bigint
        public string Key { get; set; }
        public bool Active { get; set; }
        public string City { get; set; }
        public string Name { get; set; }
        public int? StadiumID { get; set; }        // nullable int
        public string Conference { get; set; }
        public string Division { get; set; }
        public string PrimaryColor { get; set; }
        public string SecondaryColor { get; set; }
        public string TertiaryColor { get; set; }
        public string QuaternaryColor { get; set; }
        public string WikipediaLogoUrl { get; set; }
        public string WikipediaWordMarkUrl { get; set; }
        public int? GlobalTeamID { get; set; }     // nullable int
    }
}]]></arrayElement>
