using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;
using System;
using System.Collections.Generic;
using System.Net.Http;
using Newtonsoft.Json;
#endregion

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    public override void CreateNewOutputRows()
    {
        System.Net.ServicePointManager.SecurityProtocol =
            System.Net.SecurityProtocolType.Tls12;

        string apiKey = Variables.SportsDataApiKey;

        string url = "https://api.sportsdata.io/api/nhl/fantasy/json/PlayerSeasonStats/2026?key=" + apiKey;

        try
        {
            using (var client = new HttpClient())
            {
                var response = client.GetStringAsync(url).Result;
                var stats = JsonConvert.DeserializeObject<List<PlayerStat>>(response);

                foreach (var s in stats)
                {
                    Output0Buffer.AddRow();

                    // Integer fields
                    Output0Buffer.StatID = s.StatID.HasValue ? s.StatID.Value : 0;
                    Output0Buffer.TeamID = s.TeamID.HasValue ? s.TeamID.Value : 0;
                    Output0Buffer.PlayerID = s.PlayerID.HasValue ? s.PlayerID.Value : 0;
                    Output0Buffer.SeasonType = s.SeasonType.HasValue ? s.SeasonType.Value : 0;
                    Output0Buffer.Season = s.Season.HasValue ? s.Season.Value : 0;
                    Output0Buffer.Games = s.Games.HasValue ? s.Games.Value : 0;
                    Output0Buffer.Minutes = s.Minutes.HasValue ? s.Minutes.Value : 0;
                    Output0Buffer.Seconds = s.Seconds.HasValue ? s.Seconds.Value : 0;
                    Output0Buffer.GoaltendingMinutes = s.GoaltendingMinutes.HasValue ? s.GoaltendingMinutes.Value : 0;
                    Output0Buffer.GoaltendingSeconds = s.GoaltendingSeconds.HasValue ? s.GoaltendingSeconds.Value : 0;
                    Output0Buffer.Started = s.Started.HasValue ? s.Started.Value : 0;
                 

                    // Decimal fields
                    Output0Buffer.FantasyPoints = s.FantasyPoints ?? 0;
                    Output0Buffer.FantasyPointsFanDuel = s.FantasyPointsFanDuel ?? 0;
                    Output0Buffer.FantasyPointsDraftKings = s.FantasyPointsDraftKings ?? 0;
                    Output0Buffer.Goals = s.Goals ?? 0;
                    Output0Buffer.Assists = s.Assists ?? 0;
                    Output0Buffer.ShotsOnGoal = s.ShotsOnGoal ?? 0;
                    Output0Buffer.PowerPlayGoals = s.PowerPlayGoals ?? 0;
                    Output0Buffer.ShortHandedGoals = s.ShortHandedGoals ?? 0;
                    Output0Buffer.EmptyNetGoals = s.EmptyNetGoals ?? 0;
                    Output0Buffer.PowerPlayAssists = s.PowerPlayAssists ?? 0;
                    Output0Buffer.ShortHandedAssists = s.ShortHandedAssists ?? 0;
                    Output0Buffer.HatTricks = s.HatTricks ?? 0;
                    Output0Buffer.ShootoutGoals = s.ShootoutGoals ?? 0;
                    Output0Buffer.PlusMinus = s.PlusMinus ?? 0;
                    Output0Buffer.PenaltyMinutes = s.PenaltyMinutes ?? 0;
                    Output0Buffer.Blocks = s.Blocks ?? 0;
                    Output0Buffer.Hits = s.Hits ?? 0;
                    Output0Buffer.GoaltendingShotsAgainst = s.GoaltendingShotsAgainst ?? 0;
                    Output0Buffer.GoaltendingGoalsAgainst = s.GoaltendingGoalsAgainst ?? 0;
                    Output0Buffer.GoaltendingSaves = s.GoaltendingSaves ?? 0;
                    Output0Buffer.GoaltendingWins = s.GoaltendingWins ?? 0;
                    Output0Buffer.GoaltendingLosses = s.GoaltendingLosses ?? 0;
                    Output0Buffer.GoaltendingShutouts = s.GoaltendingShutouts ?? 0;
                    Output0Buffer.GoaltendingOvertimeLosses = s.GoaltendingOvertimeLosses ?? 0;

                    // String fields
                    Output0Buffer.Name = s.Name ?? "";
                    Output0Buffer.Team = s.Team ?? "";
                    Output0Buffer.Position = s.Position ?? "";


                
                }
            }
        }
        catch (Exception ex)
        {
            bool cancel;
            this.ComponentMetaData.FireError(0, "Script Component",
                $"Error fetching or parsing API: {ex.Message}", "", 0, out cancel);
        }
    }

    // C# class mapping JSON
    public class PlayerStat
    {
        public int? StatID { get; set; }
        public int? TeamID { get; set; }
        public int? PlayerID { get; set; }
        public int? SeasonType { get; set; }
        public int? Season { get; set; }
        public string Name { get; set; }
        public string Team { get; set; }
        public string Position { get; set; }
        public int? Games { get; set; }
        public decimal? FantasyPoints { get; set; }
        public decimal? FantasyPointsFanDuel { get; set; }
        public decimal? FantasyPointsDraftKings { get; set; }
        public int? Minutes { get; set; }
        public int? Seconds { get; set; }
        public decimal? Goals { get; set; }
        public decimal? Assists { get; set; }
        public decimal? ShotsOnGoal { get; set; }
        public decimal? PowerPlayGoals { get; set; }
        public decimal? ShortHandedGoals { get; set; }
        public decimal? EmptyNetGoals { get; set; }
        public decimal? PowerPlayAssists { get; set; }
        public decimal? ShortHandedAssists { get; set; }
        public decimal? HatTricks { get; set; }
        public decimal? ShootoutGoals { get; set; }
        public decimal? PlusMinus { get; set; }
        public decimal? PenaltyMinutes { get; set; }
        public decimal? Blocks { get; set; }
        public decimal? Hits { get; set; }
        public int? GoaltendingMinutes { get; set; }
        public int? GoaltendingSeconds { get; set; }
        public decimal? GoaltendingShotsAgainst { get; set; }
        public decimal? GoaltendingGoalsAgainst { get; set; }
        public decimal? GoaltendingSaves { get; set; }
