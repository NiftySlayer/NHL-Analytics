                    <arrayElement
                      dataType="System.String"><![CDATA[#region Namespaces
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;
using System;
using System.Collections.Generic;
using System.Net.Http;
using Newtonsoft.Json;
#endregion

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    public override void CreateNewOutputRows()
    {
        System.Net.ServicePointManager.SecurityProtocol =
            System.Net.SecurityProtocolType.Tls12;

        string apiKey = Variables.SportsDataApiKey;

        string url = "https://api.sportsdata.io/api/nhl/fantasy/json/Standings/2026?key=" + apiKey;

        try
        {
            using (var client = new HttpClient())
            {
                var response = client.GetStringAsync(url).Result;
                var teams = JsonConvert.DeserializeObject<List<Team>>(response);

                // Track added TeamIDs to avoid duplicates
                HashSet<int> addedTeamIDs = new HashSet<int>();

                foreach (var t in teams)
                {
                    if (addedTeamIDs.Contains(t.TeamID))
                        continue;

                    Output0Buffer.AddRow();

                    Output0Buffer.Season = t.Season;
                    Output0Buffer.SeasonType = t.SeasonType;
                    Output0Buffer.TeamID = t.TeamID;
                    Output0Buffer.Key = t.Key ?? "";
                    Output0Buffer.City = t.City ?? "";
                    Output0Buffer.Name = t.Name ?? "";
                    Output0Buffer.Conference = t.Conference ?? "";
                    Output0Buffer.Division = t.Division ?? "";
                    Output0Buffer.Wins = t.Wins ?? 0;
                    Output0Buffer.Losses = t.Losses ?? 0;
                    Output0Buffer.OvertimeLosses = t.OvertimeLosses ?? 0;
                    Output0Buffer.Percentage = t.Percentage ?? 0m;
                    Output0Buffer.ConferenceWins = t.ConferenceWins ?? 0;
                    Output0Buffer.ConferenceLosses = t.ConferenceLosses ?? 0;
                    Output0Buffer.DivisionWins = t.DivisionWins ?? 0;
                    Output0Buffer.DivisionLosses = t.DivisionLosses ?? 0;
                    Output0Buffer.ShutoutWins = t.ShutoutWins ?? 0;
                    Output0Buffer.ConferenceRank = t.ConferenceRank ?? 0;
                    Output0Buffer.DivisionRank = t.DivisionRank ?? 0;
                    Output0Buffer.GlobalTeamID = t.GlobalTeamID ?? 0;

                    addedTeamIDs.Add(t.TeamID);
                }
            }
        }
        catch (Exception ex)
        {
            bool cancel;
            this.ComponentMetaData.FireError(
                0,
                "Script Component",
                $"Error fetching or parsing API: {ex.Message}",
                "",
                0,
                out cancel
            );
        }
    }

    // Map JSON to C# class
    public class Team
    {
        public int Season { get; set; }
        public int SeasonType { get; set; }
        public int TeamID { get; set; }
        public string Key { get; set; }
        public string City { get; set; }
        public string Name { get; set; }
        public string Conference { get; set; }
        public string Division { get; set; }
        public int? Wins { get; set; }
        public int? Losses { get; set; }
        public int? OvertimeLosses { get; set; }
        public decimal? Percentage { get; set; }
        public int? ConferenceWins { get; set; }
        public int? ConferenceLosses { get; set; }
        public int? DivisionWins { get; set; }
        public int? DivisionLosses { get; set; }
        public int? ShutoutWins { get; set; }
        public int? ConferenceRank { get; set; }
        public int? DivisionRank { get; set; }
        public int? GlobalTeamID { get; set; }
    }
}]]></arrayElement>
