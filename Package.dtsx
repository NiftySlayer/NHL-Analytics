                      dataType="System.String"><![CDATA[#region Namespaces
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;
using System;
using System.Collections.Generic;
using System.Net.Http;
using Newtonsoft.Json;
#endregion

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    public override void CreateNewOutputRows()
    {
        System.Net.ServicePointManager.SecurityProtocol =
            System.Net.SecurityProtocolType.Tls12;

        string apiKey = Variables.SportsDataApiKey;

        string url = "https://api.sportsdata.io/api/nhl/odds/json/Stadiums?key=" + apiKey;

        try
        {
            using (var client = new HttpClient())
            {
                var response = client.GetStringAsync(url).Result;
                var stadiums = JsonConvert.DeserializeObject<List<Stadium>>(response);

                foreach (var s in stadiums)
                {
                    Output0Buffer.AddRow();

                    // Integer fields
                    Output0Buffer.StadiumID = s.StadiumID;
                    Output0Buffer.Capacity = s.Capacity ?? 0;

                    // Boolean fields
                    Output0Buffer.Active = s.Active;

                    // String fields (nullable in C# by default)
                    Output0Buffer.Name = s.Name ?? "";
                    Output0Buffer.Address = s.Address ?? "";
                    Output0Buffer.City = s.City ?? "";
                    Output0Buffer.State = s.State ?? "";
                    Output0Buffer.Zip = s.Zip ?? "";
                    Output0Buffer.Country = s.Country ?? "";

                    // Decimal fields
                    Output0Buffer.GeoLat = s.GeoLat ?? 0;
                    Output0Buffer.GeoLong = s.GeoLong ?? 0;
                }
            }
        }
        catch (Exception ex)
        {
            bool cancel;
            this.ComponentMetaData.FireError(0, "Script Component",
                $"Error fetching or parsing API: {ex.Message}", "", 0, out cancel);
        }
    }

    // C# class mapping JSON
    public class Stadium
    {
        public int StadiumID { get; set; }
        public bool Active { get; set; }
        public string Name { get; set; }
        public string Address { get; set; }   // nullable strings allowed without '?'
        public string City { get; set; }
        public string State { get; set; }
        public string Zip { get; set; }
        public string Country { get; set; }
        public int? Capacity { get; set; }     // nullable int
        public decimal? GeoLat { get; set; }   // nullable decimal
        public decimal? GeoLong { get; set; }  // nullable decimal
    }
}]]></arrayElement>
